# ------------------------------------------------------------
# riscv-vp specific (only applies if ESL itself generates
# these intermediate files; does not affect submodule's
# own ignore rules if riscv-vp is a submodule)
# ------------------------------------------------------------
riscv-vp-build/
sw/build/
vp/build/

# ------------------------------------------------------------
# Explicitly preserved: images and PDFs
# No rule above ignores these extensions, so they will be
# tracked by default. If a future rule accidentally covers
# them, add a negation pattern here (e.g. !*.pdf).
# ------------------------------------------------------------
# Images:  *.png, *.jpg, *.jpeg, *.gif, *.svg, *.bmp, *.ico, *.tiff, *.webp
# PDF:     *.pdf

